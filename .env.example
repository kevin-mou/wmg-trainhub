# ===== TrainHub 配置示例 =====
# 复制为 .env 后由 start.sh 读取（也可直接 export 环境变量）。

# 数据根目录：数据库 / 数据集 / Notebook / 训练日志与产物都在这里
TRAINHUB_DATA_DIR=/data/trainhub
# 共享模型缓存（HF cache 根目录；所有 Notebook 会话与训练任务共用，默认 $TRAINHUB_DATA_DIR/model-cache）
# 可指向已有 HF 缓存或独立磁盘，例如 /data/trainhub/model-cache；相对路径按 TRAINHUB_DATA_DIR 解析
# TRAINHUB_MODEL_DIR=/data/trainhub/model-cache
# SQLite 数据库文件（默认 $TRAINHUB_DATA_DIR/trainhub.db）
# TRAINHUB_DB_PATH=/data/trainhub/trainhub.db

# 管理端令牌：启用 /api/admin/** 接口，用 openssl rand -hex 32 生成
TRAINHUB_ADMIN_TOKEN=

# HTTP 监听
TRAINHUB_HOST=0.0.0.0
TRAINHUB_PORT=7470

# 同时执行的训练任务数（单 GPU 节点建议 1）
TRAINHUB_MAX_CONCURRENT_RUNS=1
# 单次训练总时限（秒，0 = 不限制）
TRAINHUB_RUN_TIMEOUT_SECONDS=0
# 单个 notebook 单元格时限（秒，0 = 不限制）
TRAINHUB_CELL_TIMEOUT_SECONDS=0

# 编辑器交互式内核：并发会话数 / 空闲回收 / 单元格执行时限（秒）
TRAINHUB_MAX_KERNEL_SESSIONS=4
TRAINHUB_KERNEL_SESSION_IDLE_SECONDS=1800
TRAINHUB_KERNEL_CELL_TIMEOUT_SECONDS=300

# ===== Docker 沙箱（仅 Linux 节点）=====
# Linux 节点默认 docker；macOS/MLX 节点必须 none（MLX 无法在 Linux 容器中运行）
TRAINHUB_SANDBOX=docker
TRAINHUB_SANDBOX_IMAGE=trainhub-sandbox:latest
# none 最安全；此时模型需先用 trainhub.cli models pull 预拉（HF_HUB_OFFLINE=1）
TRAINHUB_SANDBOX_NETWORK=none
TRAINHUB_SANDBOX_MEMORY_MB=4096
TRAINHUB_SANDBOX_CPUS=2
TRAINHUB_SANDBOX_PIDS_LIMIT=512
# GPU：all / device=0；生产建议 MIG 或按设备分配
# TRAINHUB_SANDBOX_GPUS=device=0
# 默认使用服务用户的 uid:gid；服务不能以 root 运行
# TRAINHUB_SANDBOX_RUN_AS=1000:1000
# 必须短（Unix socket 路径限制），默认 /var/tmp/trainhub-ipc
# TRAINHUB_SANDBOX_IPC_DIR=/var/tmp/trainhub-ipc
# 共享模型缓存默认只读；联网下载模型时设为 false 并确认网络策略
# TRAINHUB_SANDBOX_MODEL_CACHE_RO=true
# 沙箱镜像内的 Python
# TRAINHUB_SANDBOX_PYTHON=python3
# 本机 none 模式额外放行的环境变量（逗号分隔）
# TRAINHUB_KERNEL_ENV_ALLOW=LD_LIBRARY_PATH,DYLD_LIBRARY_PATH

# 上传上限
TRAINHUB_MAX_DATASET_MB=10240
TRAINHUB_MAX_NOTEBOOK_MB=10
# 平台推送的代码包（.ipynb/.zip）上限
TRAINHUB_MAX_CODE_MB=200
# 平台推送的资产包（模型/基线目录）上限
TRAINHUB_MAX_ASSETS_MB=10240

# 单个训练日志文件的大小上限（超出后停止写入并附截断提示）
TRAINHUB_MAX_LOG_MB=100

# 训练结束后是否保留运行工作目录（默认清理，仅保留日志与 output/）
TRAINHUB_KEEP_RUN_WORKDIR=false

# 日志等级
TRAINHUB_LOG_LEVEL=info
