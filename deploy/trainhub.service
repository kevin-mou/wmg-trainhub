[Unit]
Description=TrainHub model training console (single-task execution service)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
User=trainhub
Group=trainhub
# Docker 沙箱（rootful Docker）需要访问 /var/run/docker.sock；使用 rootful Docker 时
# 取消下一行注释（docker 组等价于 root 权限，务必限制 7470 的访问来源）。
# SupplementaryGroups=docker
WorkingDirectory=/opt/trainhub/wmg-trainhub
Environment=PYTHONPATH=/opt/trainhub/wmg-trainhub/src
EnvironmentFile=-/etc/trainhub/trainhub.env
ExecStart=/opt/trainhub/wmg-trainhub/.venv/bin/python -m trainhub.cli serve --host 0.0.0.0 --port 7470
Restart=always
RestartSec=3

# 训练内核与平台作业会占用较多文件句柄与内存，按节点规格调整
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
